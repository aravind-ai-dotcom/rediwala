{
  "name": "rediwala-firebase-seed",
  "private": true,
  "version": "2.1.0",
  "description": "Permanent Realtime Database seed/validation for RediWala (development only)",
  "type": "module",
  "scripts": {
    "seed": "node seed.js",
    "seed:dry": "node seed.js --dry-run",
    "dry": "node seed.js --dry-run",
    "reset": "node seed.js --reset",
    "seed:reset": "node seed.js --reset",
    "seed:demo-auth": "node seed-demo-auth.js",
    "seed:demo-auth:dry": "node seed-demo-auth.js --dry-run",
    "seed:demo-auth:emulator": "node seed-demo-auth.js --emulator",
    "seed:customers": "node seed-demo-auth.js --customers",
    "seed:vendors": "node seed-demo-auth.js --vendors --supporting",
    "seed:scenarios": "node seed-demo-auth.js --scenarios",
    "seed:reset-demo": "node seed-demo-auth.js --reset --all",
    "seed:all": "node seed-demo-auth.js --all",
    "emulators": "cd .. && npx -y firebase-tools@latest emulators:start --only auth,database --project rediwala-development",
    "validate": "node validate.js --local",
    "validate:remote": "node validate.js --remote"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0"
  }
}
