    "vendor.about.kannan" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fresh catch from Thiruvanmiyur shores, sold near the MRTS station every morning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திருவanmiyur கடற்கரையிலிருந்து புதிய மீன், MRTS நிலையம் அருகில் ஒவ்வொரு காலையும்."
          }
        }
      }
    },
    "vendor.about.lakshmi" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seasonal fruits from T. Nagar, stacked fresh near Pondy Bazaar every day."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தி. நகரில் பருவ பழங்கள், பாண்டி பஜார் அருகில் தினமும் புதிதாக."
          }
        }
      }
    },
    "vendor.about.meenakshi" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm buns and tea-time snacks near Besant Nagar Beach for evening walkers."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெசант நகர் கடற்கரை அருகில் மாலை நடைபயணிகளுக்கு சூடான பண் மற்றும் snacks."
          }
        }
      }
    },
    "vendor.about.murugan" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fresh greens and local produce from Pondy Bazaar, T. Nagar every morning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாண்டி பஜார், தி. நகரிலிருந்து ஒவ்வொரு காலையும் புதிய காய்கறிகள்."
