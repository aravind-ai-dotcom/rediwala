    "onboarding.location.benefit1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find vendors near Pondy Bazaar, T. Nagar, and more"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாண்டி பஜார், தி. நகர் மற்றும் பிற இடங்களில் அருகிலுள்ள வியாபாரிகளைக் கண்டறியுங்கள்"
          }
        }
      }
    },
    "onboarding.location.benefit2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See who's open right now"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இப்போது யார் திறந்திருக்கிறார்கள் என்பதைப் பாருங்கள்"
          }
        }
      }
    },
    "onboarding.location.benefit3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
