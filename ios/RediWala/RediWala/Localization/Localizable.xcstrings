    },
    "vendor.about.lakshmi" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seasonal fruits from T. Nagar, stacked fresh near Pondy Bazaar every day."
