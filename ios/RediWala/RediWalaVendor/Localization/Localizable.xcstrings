    "%@ – %@" : {
      "comment" : "A time range indicating when a stop is scheduled to arrive and depart. The first argument is the arrival time, formatted for display. The second argument is the departure time, formatted for display.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ – %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A label displaying the number of customers at a given demand signal. The argument is the number of customers at the signal.",
      "isCommentAutoGenerated" : true
    },
    "%lld interested" : {
      "comment" : "A label that shows the number of people who are interested in a given stop. The argument is the number of interested people.",
      "isCommentAutoGenerated" : true
    },
    "%llds / %llds" : {
      "comment" : "A label showing the duration of the recorded announcement. The argument is the elapsed time in seconds, and the second argument is the maximum allowed duration in seconds.",
